---
import AppLayout from '../layouts/AppLayout.astro';
import Modal from '../components/Modal.astro';
import Icon from '../components/Icon.astro';
---
<AppLayout titulo="Ajustes" subtitulo="Insumos, usuarios y cuenta">
    <div class="grid gap-5">
        <!-- Insumos -->
        <section class="tarjeta">
        <div class="tarjeta-cabecera">
            <div>
            <h2 class="tarjeta-titulo">Insumos</h2>
            <p class="text-xs text-texto-3">Núcleos, cereales y remedios que se compran y se usan en las moliendas</p>
            </div>
            <button type="button" class="btn btn-sm btn-primario" id="btn-insumo"><Icon name="plus" class="icon size-4" /> Nuevo insumo</button>
        </div>
        <div class="tabla-contenedor"><table class="tabla tabla-movil" id="t-insumos"></table></div>
        </section>

        <!-- Usuarios -->
        <section class="tarjeta" data-solo-dueno>
        <div class="tarjeta-cabecera">
            <div>
            <h2 class="tarjeta-titulo">Usuarios</h2>
            <p class="text-xs text-texto-3">El empleado puede cargar datos, pero no ve ventas, gastos ni balance</p>
            </div>
        </div>
        <div class="tabla-contenedor"><table class="tabla tabla-movil" id="t-usuarios"></table></div>
        </section>

        <!-- Cuenta -->
        <section class="tarjeta">
        <div class="tarjeta-cabecera"><h2 class="tarjeta-titulo">Mi cuenta</h2></div>
        <form id="form-clave" class="grid max-w-md gap-4 p-4">
            <p class="text-[13px] text-texto-2">Usuario: <strong data-usuario-nombre></strong> (<span data-usuario-rol></span>)</p>
            <div class="campo">
            <label class="etiqueta" for="clave1">Nueva contraseña</label>
            <input class="input" id="clave1" name="clave1" type="password" minlength="8" autocomplete="new-password" required />
            </div>
            <div class="campo">
            <label class="etiqueta" for="clave2">Repetir contraseña</label>
            <input class="input" id="clave2" name="clave2" type="password" minlength="8" autocomplete="new-password" required />
            </div>
            <button type="submit" class="btn btn-primario justify-self-start" id="btn-clave"><Icon name="lock" class="icon size-4" /> Cambiar contraseña</button>
        </form>
        </section>
    </div>

    <Fragment slot="modales">
        <Modal id="m-insumo" titulo="Nuevo insumo">
        <input type="hidden" name="id" />
        <div class="campo">
            <label class="etiqueta" for="i-nombre">Nombre</label>
            <input class="input" id="i-nombre" name="nombre" required maxlength="80" />
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div class="campo">
            <label class="etiqueta" for="i-tipo">Tipo</label>
            <select class="input" id="i-tipo" name="tipo" required></select>
            </div>
            <div class="campo">
            <label class="etiqueta" for="i-unidad">Unidad</label>
            <select class="input" id="i-unidad" name="unidad" required></select>
            </div>
        </div>
        <p class="ayuda">Solo los insumos en kg pueden usarse en las moliendas.</p>
        </Modal>
    </Fragment>
</AppLayout>

<script>
    import { supabase } from '../lib/supabase';
    import { iniciarPagina, type Perfil } from '../lib/sesion';
    import { esc } from '../lib/formato';
    import { aviso, avisoError, alAccion, botonAccion, conCarga, confirmar, eliminarFila, guardarFila, leerForm, llenarForm, modal, renderTabla, tablaCargando, type Columna } from '../lib/ui';
    import { ROLES, TIPOS_INSUMO, UNIDADES, opciones } from '../lib/etiquetas';

    const tIns = document.getElementById('t-insumos') as HTMLTableElement;
    const tUsu = document.getElementById('t-usuarios') as HTMLTableElement;
    let insumos: any[] = [];
    let yo: Perfil;

    /* -------- Insumos -------- */
    async function cargarInsumos() {
        tablaCargando(tIns, 4, 5);
        const { data, error } = await supabase.from('insumos').select('*').order('tipo').order('nombre');
        if (error) return avisoError(error);
        insumos = data ?? [];
        const col: Columna<any>[] = [
        { titulo: 'Nombre', valor: (i) => esc(i.nombre) },
        { titulo: 'Tipo', valor: (i) => TIPOS_INSUMO[i.tipo] },
        { titulo: 'Unidad', valor: (i) => UNIDADES[i.unidad] },
        { titulo: 'Estado', valor: (i) => (i.activo ? '<span class="badge badge-ok">Activo</span>' : '<span class="badge">Inactivo</span>') },
        {
            titulo: '',
            clase: 'acciones',
            valor: (i) =>
            `<button type="button" class="btn btn-sm btn-fantasma" data-accion="activo" data-id="${i.id}">${i.activo ? 'Desactivar' : 'Activar'}</button>` +
            botonAccion('editar', i.id, 'pencil', 'Editar') +
            botonAccion('eliminar', i.id, 'trash', 'Eliminar'),
        },
        ];
        renderTabla(tIns, col, insumos, { vacio: 'No hay insumos cargados.' });
    }

    const m = modal('m-insumo');
    (m.form.elements.namedItem('tipo') as HTMLSelectElement).innerHTML = opciones(TIPOS_INSUMO);
    (m.form.elements.namedItem('unidad') as HTMLSelectElement).innerHTML = opciones(UNIDADES);

    document.getElementById('btn-insumo')!.addEventListener('click', () => {
        m.form.reset();
        llenarForm(m.form, { id: '', tipo: 'nucleo', unidad: 'kg' });
        m.abrir('Nuevo insumo');
    });

    alAccion(tIns, {
        editar: (id) => {
        const i = insumos.find((x) => String(x.id) === id);
        if (!i) return;
        m.form.reset();
        llenarForm(m.form, i);
        m.abrir('Editar insumo');
        },
        activo: async (id, btn) => {
        const i = insumos.find((x) => String(x.id) === id);
        if (!i) return;
        conCarga(btn, async () => {
            try {
            await guardarFila('insumos', { activo: !i.activo }, id);
            aviso(i.activo ? 'Insumo desactivado' : 'Insumo activado');
            cargarInsumos();
            } catch (e) {
            avisoError(e);
            }
        });
        },
        eliminar: async (id) => {
        if (!(await confirmar('¿Eliminar este insumo? Si ya tiene compras o moliendas, no se podrá eliminar (desactivalo en su lugar).', { boton: 'Eliminar' }))) return;
        try {
            await eliminarFila('insumos', id);
            aviso('Insumo eliminado');
            cargarInsumos();
        } catch (e: any) {
            if (e?.code === '23503') aviso('Este insumo tiene compras o moliendas. Desactivalo en lugar de eliminarlo.', 'error');
            else avisoError(e);
        }
        },
    });

    m.form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        conCarga(m.form.querySelector('[data-guardar]'), async () => {
        const d = leerForm(m.form);
        try {
            await guardarFila('insumos', { nombre: d.nombre, tipo: d.tipo, unidad: d.unidad }, d.id || null);
            m.cerrar();
            aviso(d.id ? 'Insumo actualizado' : 'Insumo creado');
            cargarInsumos();
        } catch (e) {
            avisoError(e);
        }
        });
    });

    /* -------- Usuarios -------- */
    async function cargarUsuarios() {
        tablaCargando(tUsu, 3, 2);
        const { data, error } = await supabase.from('perfiles').select('*').order('creado_en');
        if (error) return avisoError(error);
        const col: Columna<any>[] = [
        { titulo: 'Nombre', valor: (u) => esc(u.nombre) + (u.id === yo.id ? ' <span class="badge">Vos</span>' : '') },
        { titulo: 'Correo', valor: (u) => esc(u.email ?? '—') },
        {
            titulo: 'Rol',
            clase: 'acciones',
            valor: (u) =>
            u.id === yo.id
                ? `<span class="badge badge-marca">${ROLES[u.rol]}</span>`
                : `<select class="input h-8 w-36 text-[13px]" data-rol="${u.id}" aria-label="Rol de ${esc(u.nombre)}">${opciones(ROLES, u.rol)}</select>`,
        },
        ];
        renderTabla(tUsu, col, data ?? []);
    }

    tUsu.addEventListener('change', async (ev) => {
        const sel = ev.target as HTMLSelectElement;
        const id = sel.dataset.rol;
        if (!id) return;
        sel.disabled = true;
        try {
        await guardarFila('perfiles', { rol: sel.value }, id);
        aviso('Rol actualizado');
        } catch (e) {
        avisoError(e);
        cargarUsuarios();
        } finally {
        sel.disabled = false;
        }
    });

    /* -------- Contraseña -------- */
    const fc = document.getElementById('form-clave') as HTMLFormElement;
    fc.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const d = leerForm(fc);
        if (d.clave1 !== d.clave2) {
        aviso('Las contraseñas no coinciden.', 'error');
        return;
        }
        conCarga(document.getElementById('btn-clave') as HTMLButtonElement, async () => {
        const { error } = await supabase.auth.updateUser({ password: d.clave1 });
        if (error) {
            aviso(/different from the old/i.test(error.message) ? 'La nueva contraseña debe ser distinta de la actual.' : error.message, 'error');
            return;
        }
        fc.reset();
        aviso('Contraseña actualizada');
        });
    });

    iniciarPagina().then((p) => {
        yo = p;
        // El layout ya pinta nombre y rol; repetir para el bloque de cuenta
        document.querySelectorAll<HTMLElement>('[data-usuario-nombre]').forEach((el) => (el.textContent = p.nombre || p.email || ''));
        cargarInsumos();
        if (p.rol === 'dueno') cargarUsuarios();
    });
</script>